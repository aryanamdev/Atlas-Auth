# Server config
PORT=port
NODE_ENV=development
LOG_LEVEL=info
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=atlas-auth
JWT_KID=auth-server-key
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

APP_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to make credentialed requests
# (must match the frontend's origin, e.g. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Arcjet for security
ARCJET_KEY=arcjet_security_key
ARCJET_ENV=development

# Recommended for most uses
DATABASE_URL=database_connection_url

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=database_unplooled_url

# Parameters for constructing your own connection string
PGHOST=db_host
PGHOST_UNPOOLED=db_host_unpooled
PGUSER=postgres_user
PGDATABASE=postgres_db_name
PGPASSWORD=postgres_db_name

# Parameters for Vercel Postgres Templates
POSTGRES_URL=postgres_url
POSTGRES_URL_NON_POOLING=postgres_url_non_pooling
POSTGRES_USER=postgres_user
POSTGRES_HOST=postgres_host
POSTGRES_PASSWORD=postgres_password
POSTGRES_DATABASE=postgres_db
POSTGRES_URL_NO_SSL=postgres_url_no_ssl
POSTGRES_PRISMA_URL=postgres_prisma_url
